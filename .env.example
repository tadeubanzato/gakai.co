# Gakai runtime configuration.
#
# ./scripts/gakai-up.sh generates a real .env for you automatically — you do
# not need to copy or edit this file by hand for a normal local run. This
# file exists purely as documentation of what Gakai reads from the
# environment.

# Required. A long random secret used to encrypt sensitive values Gakai
# stores locally (for example, a connected n8n instance's API key) so they
# are never held in plain text. Auto-generated by gakai-up.sh; if you set
# this by hand, use at least 32 random bytes (e.g. `openssl rand -hex 32`).
GAKAI_STATE_SECRET=

# Optional. Port Gakai is reachable on from the host. Defaults to 3000.
# GAKAI_PORT=3000

# Optional. Interface Gakai's port is published on. Defaults to 0.0.0.0
# (reachable from other devices on your network). Set to 127.0.0.1 to
# restrict Gakai to the local machine only.
# GAKAI_BIND_ADDRESS=0.0.0.0

# Optional. Overrides the URL gakai-up.sh prints as Gakai's address, for
# deployments behind a reverse proxy or a domain name.
# GAKAI_PUBLIC_URL=

# Optional. How long an admin login session stays valid, in milliseconds.
# Defaults to 24 hours.
# GAKAI_SESSION_TTL_MS=86400000

# Optional. Inbox tuning — how far back (in days) a chat with no recent
# activity is still considered part of the inbox, and how many chats the
# inbox shows at once.
# GAKAI_INBOX_RECENCY_DAYS=60
# GAKAI_INBOX_CHAT_LIMIT=40

# Optional. How long Gakai waits before retrying a failed Instagram link
# preview fetch, in milliseconds.
# GAKAI_INSTAGRAM_PREVIEW_RETRY_MS=300000
