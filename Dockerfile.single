FROM node:22-alpine AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY client ./client
COPY scripts/build-client.mjs ./scripts/build-client.mjs
COPY public ./public
RUN npm run build

# The release image inherits the provider runtime and its browser/system
# dependencies. At runtime it exposes only Gakai; the provider stays on the
# loopback interface and is started as a supervised child process.
FROM devlikeapro/waha
WORKDIR /gakai
COPY server.mjs ./server.mjs
COPY src ./src
COPY --from=frontend /build/public ./public
COPY scripts/entrypoint-single.sh /usr/local/bin/gakai-entrypoint
RUN chmod +x /usr/local/bin/gakai-entrypoint

ENV PORT=3001
ENV HOME_DATA_DIR=/data
ENV GAKAI_PROVIDER_URL=http://127.0.0.1:3000
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3001/healthz').then(response=>process.exit(response.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/usr/local/bin/gakai-entrypoint"]
